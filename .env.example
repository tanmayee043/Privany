# Port for the API server
PORT=8787

# Policy reader. Leave unset for the free, offline rule-based reader.
# Set to "claude" (and add a key below) to read policies with Claude instead;
# that costs roughly $0.10-0.40 per site checked.
# PRIVANY_POLICY_READER=claude
# ANTHROPIC_API_KEY=

# Limits (all optional; defaults shown)
# PRIVANY_RATE_LIMIT_PER_MIN=10     # checks one client may start per minute
# PRIVANY_POLL_LIMIT_PER_MIN=600    # status polls per minute
# PRIVANY_MAX_QUEUE=5               # checks waiting or running before the API answers 503
# PRIVANY_CONCURRENCY=1             # checks run at once (1-8); higher uses more memory and bandwidth
# PRIVANY_JOB_TIMEOUT_MS=300000     # stop a check after this long
# PRIVANY_CACHE_TTL_MS=3600000      # reuse a recent report for this long (0 disables)
# PRIVANY_MAX_REPORTS=200           # reports kept on disk
# PRIVANY_TRUST_PROXY=              # set to 1 behind one reverse proxy so each user gets their own limit
